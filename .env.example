# Copy to `.env` for docker-compose and local `bin/rails` (dotenv-rails loads `.env`
# in development and test).

# --- PostgreSQL (Docker + local Rails) ---
POSTGRES_USER=ddd_eds
POSTGRES_PASSWORD=ddd_eds
POSTGRES_DB=ddd_eds_development
# Host port mapped to the container (default 15432 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=15432

DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_USER=ddd_eds
DATABASE_PASSWORD=ddd_eds

# Use a local PostgreSQL on the default port instead of Docker:
#   DATABASE_PORT=5432
# and point DATABASE_HOST at that server.

# If the Docker volume was first created with other credentials, Postgres ignores
# later POSTGRES_* changes until you remove the volume (`docker compose down -v`).

# --- Full docker-compose (web + postgres) ---
# When using `docker compose up`, set in .env if not using defaults:
# WEB_PORT=3000
# APPLICATION_HOST=localhost
# APPLICATION_PORT=3000
