<div class="mx-auto max-w-md">
  <div class="ui-card--stack">
    <h1 class="ui-page-title">Sign in</h1>
    <p class="ui-page-desc">Welcome back. Sign in to open your rooms and invite links.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "ui-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "ui-input" %>
      </div>

      <div>
        <%= f.label :password, class: "ui-label" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "ui-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-zinc-300 text-zinc-900 focus:ring-zinc-500" %>
          <%= f.label :remember_me, "Remember me", class: "text-sm text-zinc-700" %>
        </div>
      <% end %>

      <%= f.submit "Sign in", class: "ui-btn-primary ui-btn-primary--block" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-zinc-600">
      Need an account?
      <%= link_to "Sign up", new_registration_path(resource_name), class: "ui-link" %>
    </p>
  </div>
</div>
