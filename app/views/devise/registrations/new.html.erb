<div class="mx-auto max-w-md">
  <div class="ui-card--stack">
    <h1 class="ui-page-title">Create account</h1>
    <p class="ui-page-desc">Join ExpenseSplit to share rooms and track balances.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :display_name, "Display name", class: "ui-label" %>
        <%= f.text_field :display_name, autofocus: true, required: true, class: "ui-input" %>
      </div>

      <div>
        <%= f.label :email, class: "ui-label" %>
        <%= f.email_field :email, autocomplete: "email", required: true, class: "ui-input" %>
      </div>

      <div>
        <%= f.label :password, class: "ui-label" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-zinc-500">(<%= @minimum_password_length %> characters minimum)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, class: "ui-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "ui-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "ui-input" %>
      </div>

      <%= f.submit "Sign up", class: "ui-btn-primary ui-btn-primary--block" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-zinc-600">
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "ui-link" %>
    </p>
  </div>
</div>
