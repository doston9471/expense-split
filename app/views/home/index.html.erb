<div class="grid gap-8 lg:grid-cols-[1.1fr_minmax(0,0.9fr)] lg:items-center">
  <div class="ui-card--hero">
    <div class="relative">
      <p class="ui-kicker">Shared expenses, solved</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl">
        Split costs fairly, without the spreadsheet chaos.
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-600">
        Create a room, invite people with a link, add expenses, and keep balances in sync automatically.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to "Create free account", new_user_registration_path, class: "ui-btn-primary px-6" %>
        <%= link_to "Sign in", new_user_session_path, class: "ui-btn-secondary px-6" %>
      </div>
      <dl class="mt-10 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-zinc-100 bg-zinc-50/80 px-4 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Rooms</dt>
          <dd class="mt-1 text-sm font-semibold text-zinc-900">Trips, roommates, teams</dd>
        </div>
        <div class="rounded-xl border border-zinc-100 bg-zinc-50/80 px-4 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Splits</dt>
          <dd class="mt-1 text-sm font-semibold text-zinc-900">Equal shares, clear totals</dd>
        </div>
        <div class="rounded-xl border border-zinc-100 bg-zinc-50/80 px-4 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500">Balances</dt>
          <dd class="mt-1 text-sm font-semibold text-zinc-900">Who owes whom, updated</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="ui-card hidden lg:block">
    <p class="text-sm font-semibold text-zinc-900">How it works</p>
    <ol class="mt-4 space-y-4 text-sm text-zinc-600">
      <li class="flex gap-3">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-800">1</span>
        <span><strong class="text-zinc-900">Create a room</strong> for your group and pick a name everyone recognizes.</span>
      </li>
      <li class="flex gap-3">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-800">2</span>
        <span><strong class="text-zinc-900">Share the invite link</strong> so people can join with their own accounts.</span>
      </li>
      <li class="flex gap-3">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-800">3</span>
        <span><strong class="text-zinc-900">Log expenses and settlements</strong> — balances stay accurate as you go.</span>
      </li>
    </ol>
  </div>
</div>
