<div class="mx-auto max-w-lg">
  <h1 class="ui-page-title">Record settlement</h1>
  <p class="ui-page-desc">Someone paid someone else to settle up.</p>

  <%= form_with model: @settlement, url: room_settlements_path(@room), class: "ui-card mt-8 space-y-5" do |f| %>
    <div>
      <%= f.label :payer_id, "Who paid", class: "ui-label" %>
      <%= f.collection_select :payer_id, @room.members.order(:display_name), :id, :display_name, { prompt: "Select payer" }, class: "ui-select" %>
    </div>
    <div>
      <%= f.label :payee_id, "Who received", class: "ui-label" %>
      <%= f.collection_select :payee_id, @room.members.order(:display_name), :id, :display_name, { prompt: "Select recipient" }, class: "ui-select" %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :amount, class: "ui-label" %>
        <%= f.text_field :amount, required: true, placeholder: "250.00", class: "ui-input" %>
      </div>
      <div>
        <%= f.label :currency, class: "ui-label" %>
        <%= f.text_field :currency, value: @settlement.currency, class: "ui-input" %>
      </div>
    </div>
    <div>
      <%= f.label :note, class: "ui-label" %>
      <%= f.text_field :note, class: "ui-input" %>
    </div>
    <%= f.submit "Save settlement", class: "ui-btn-primary ui-btn-primary--block" %>
    <%= link_to "Cancel", room_path(@room), class: "ui-link-muted mt-3 block" %>
  <% end %>
</div>
