<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="ui-page-title">Your rooms</h1>
    <p class="ui-page-desc">Shared trips, roommates, office lunches — all in one place.</p>
  </div>
  <%= link_to "New room", new_room_path, class: "ui-btn-primary shrink-0" %>
</div>

<ul class="mt-8 divide-y divide-zinc-100 overflow-hidden rounded-2xl border border-zinc-200/80 bg-white/95 shadow-sm shadow-zinc-900/5 backdrop-blur-sm">
  <% @rooms.each do |room| %>
    <li>
      <%= link_to room_path(room), class: "group ui-room-row" do %>
        <div class="min-w-0">
          <p class="truncate font-semibold text-zinc-900"><%= room.name %></p>
          <p class="mt-0.5 text-xs text-zinc-500">Owner · <%= room.owner.display_name %></p>
        </div>
        <span class="ui-room-chevron" aria-hidden="true">→</span>
      <% end %>
    </li>
  <% end %>
  <% if @rooms.empty? %>
    <li class="px-5 py-14 text-center">
      <p class="text-sm font-medium text-zinc-700">No rooms yet</p>
      <p class="mt-1 text-sm text-zinc-500">Create one to start splitting expenses with your group.</p>
      <%= link_to "Create your first room", new_room_path, class: "ui-link mt-4 inline-block" %>
    </li>
  <% end %>
</ul>
